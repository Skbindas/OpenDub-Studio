OPENDUB_HOST=127.0.0.1
OPENDUB_PORT=7860
OPENDUB_DATA_DIR=runtime

OPENDUB_EMBED_WORKER=1
OPENDUB_WORKER_POLL_SECONDS=1.5
OPENDUB_JOB_LEASE_SECONDS=120
OPENDUB_MAX_JOB_ATTEMPTS=3

# Optional local Community-1 speaker model access. Never commit a real token.
HF_TOKEN=

# Optional semantic dialogue adaptation (OpenAI-compatible Chat Completions API).
# Leave OPENDUB_LLM_API_KEY empty to keep the conservative local suggestion path.
OPENDUB_LLM_API_KEY=
OPENDUB_LLM_BASE_URL=https://api.openai.com/v1
OPENDUB_LLM_MODEL=gpt-4o-mini
